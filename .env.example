# Copy this file to ".env" (same folder) and fill it in. ".env" is never committed.

# Assist: a vision model that reads a picture or a table the recognizer cannot.
# Off unless both the key and the model are set. Only a crop you confirm is ever sent.
# Do not use a cloud provider with export-controlled drawings.
DI_ASSIST_PROVIDER=openrouter
OPENROUTER_API_KEY=
# A vision-capable model id exactly as OpenRouter lists it. Default choice: open weights that can run locally later.
DI_ASSIST_MODEL=qwen/qwen3-vl-8b-instruct

# Upload limits
# DI_MAX_UPLOAD_MB=100
# DI_MAX_PAGES=200
