{
  "name": "drawing-intelligence",
  "private": true,
  "scripts": {
    "dev": "concurrently -n frontend,extractor -c magenta,yellow \"pnpm --filter frontend dev\" \"python packages/extractor/run.py\"",
    "build": "pnpm --filter frontend build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
